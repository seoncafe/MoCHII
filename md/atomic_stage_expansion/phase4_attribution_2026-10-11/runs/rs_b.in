&parameters
 ! Phase 4 measurement: 1e5 K blackbody in the HII40 geometry (He2+ zone),
 ! eion_max 150 eV, C N O Ne S, current defaults, transported continuum,
 ! 3 iterations restarted from the common state ../common2/d (24 iterations of build d).
 par%no_photons      = 1048576
 par%no_print        = 1048576
 par%iseed           = 1234
 par%launch_sequence = 'sobol'
 par%qmc_seed        = 20260728
 par%grid_type       = 'amr'
 par%amr_file        = '/nfs/mocafe/kiseon/MoCHII/MoCHII_v1.00/tests/g2_hii/hii40_L6_rout5p2.fits'
 par%dust_density_law = 'none'
 par%distance_unit   = 'pc'
 par%nnu_ion         = 64
 par%eion_min        = 13.598
 par%eion_max        = 150.0
 par%tstar           = 1.0e5
 par%luminosity      = 9.3598e38
 par%xHI_init        = 1.0e-3
 par%xHeI_init       = 0.1
 par%xHeII_init      = 0.5
 par%abund_He        = 0.1
 par%ion_add_dust    = .false.
 par%gas_niter       = 3
 par%restart_file    = '/nfs/mocafe/kiseon/MoCHII/MoCHII_v1.00_phase5_attrib/runs/common2/d/bb1e5_rates.h5'
 par%conv_crit       = 'vol'
 par%recombination_continuum = 'transported'
 par%solve_te        = .true.
 par%te_min          = 3.0e3
 par%te_max          = 5.0e4
 par%atomic_dir      = '/nfs/mocafe/kiseon/MoCHII/MoCHII_v1.00_phase5_attrib/data_snapshot/atomic'
 par%data_dir        = '/nfs/mocafe/kiseon/MoCHII/MoCHII_v1.00_phase5_attrib/data_snapshot'
 par%abund_C         = 2.2e-4
 par%abund_N         = 4.0e-5
 par%abund_O         = 3.3e-4
 par%abund_Ne        = 5.0e-5
 par%abund_S         = 9.0e-6
 par%source_geometry = 'point'
 par%file_format     = 'hdf5'
 par%jnu_output      = .true.
 par%emis_output     = .true.
 par%out_file        = 'bb1e5.h5'
/
