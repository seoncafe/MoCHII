&parameters
 ! Band-stratified launch of the FUV extension (par%fuv_sampling): dusty
 ! H II sphere, nH = 100, R = 4 pc, 40 kK blackbody with Q_H = 1e49 s^-1,
 ! band 4.78-100 eV.  From 4.78 eV the FUV part carries 55% of the band
 ! luminosity, so with 'proportional' only 45% of the packets ionize.  Te is
 ! held at 1e4 K and the 2^3S population is a diagnostic here (coupling off),
 ! so the field estimators compare on one state.  run_check.sh converges the
 ! state once, then transports it (restart_file, gas_niter = 0) with
 ! 'proportional', 'separate' and add_fuv = .false. at two seeds each.

 par%no_photons    = 1.0e6
 par%no_print      = 1.0e7
 par%iseed = 8642

 par%grid_type     = 'car'
 par%car_walk      = 'dda'
 par%nx            = 32
 par%ny            = 32
 par%nz            = 32
 par%xmax          = 4.0
 par%ymax          = 4.0
 par%zmax          = 4.0
 par%nH_const      = 100.0
 par%rmax          = 4.0
 par%distance_unit = 'pc'

 par%nnu_ion       = 32
 par%eion_min      = 13.598
 par%eion_max      = 100.0
 par%tstar = 40000.0
 par%luminosity    = 3.178e38

 par%add_fuv = .true.
 par%efuv_min       = 4.78
 par%nnu_fuv        = 16
 par%fuv_sampling = 'proportional'
 par%no_photons_fuv = 2.5e5

 par%xHI_init      = 1.0e-3
 par%xHeI_init     = 0.0
 par%xHeII_init    = 1.0
 par%abund_He      = 0.1

 par%gas_niter = 0
 par%conv_crit     = 'vol'
 par%gas_tol       = 5.0e-3
 par%te_fixed      = 1.0e4
 par%solve_te      = .false.
 par%ion_relax     = 1.0
 par%recombination_continuum = 'on_the_spot'
 par%hei_on_the_spot = .false.

 !--- dust in the band (MW D03 EUV/FUV extinction + scattering)
 par%dust_density_law = 'global_dgr'
 par%DGR           = 1.0
 par%ion_add_dust  = .true.
 par%ion_dust_scatter = .true.
 par%ion_dust_kext = '/nfs/mocafe/kiseon/MoCHII/MoCHII_v1.00/data/kext_albedo_WD_MW_3.1_60_D03.all_2003'
 par%cext_dust     = 4.868e-22
 par%dust_emis_transport = .false.

 par%hei_metastable          = .true.
 par%hei_metastable_coupling = .false.

 par%source_geometry = 'point'
 par%launch_sequence = 'random'
 par%file_format     = 'hdf5'
 par%out_file = 't40_prop_s8642.h5'
 par%heii_on_the_spot = .false.   ! pinned: this input predates the default .true.
 par%restart_file = '/nfs/mocafe/kiseon/MoCHII/MoCHII_v1.00/results/fuv_stratified_gate_2026-09-26/base_rates.h5'
/
