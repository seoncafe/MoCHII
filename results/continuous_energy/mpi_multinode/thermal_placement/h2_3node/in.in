&parameters
 par%ion_energy_mode = 'grouped'
 ! MoCHII G2 gate: MOCASSIN/Lexington HII20 benchmark.
 ! Blackbody 20 kK, Q_H = 1.006e49 s^-1, nH = 100 cm^-3, hollow shell
 ! Rin = 3e18 cm, Rout = 9.5e18 cm; abundances He 0.1, C 2.2e-4, N 4e-5,
 ! O 3.3e-4, Ne 5e-5, S 9e-6.  Reference: MOCASSIN baseline
 ! Te(H+) = 7046.6 K (tests/baselines/01_gas_HII20).

 par%iseed         = 1234

 par%grid_type     = 'amr'
 par%dust_density_law = 'none'
 par%distance_unit = 'pc'

 !--- ionizing band: L set so that Q_H = 1.006e49 (mean E = 16.053 eV)
 par%nnu_ion       = 32
 par%eion_min      = 13.598
 par%eion_max      = 100.0
 par%tstar         = 2.0e4
 par%luminosity    = 2.587394e38

 !--- ionized start (fast convergence; equilibrium is unique)
 par%xHI_init      = 1.0e-3
 par%xHeI_init     = 0.5
 par%xHeII_init    = 0.5
 par%abund_He      = 0.1
 par%ion_add_dust  = .false.

 !--- G1/G2 iteration: thermal balance + metals, case B
 par%gas_tol       = 5.0e-3
 par%ion_relax     = 1.0
 par%recombination_continuum = 'on_the_spot'
 par%solve_te      = .true.
 par%te_min        = 3.0e3
 par%te_max        = 3.0e4
 par%gas_tol_te    = 5.0e-3
 par%use_metals    = .true.
 par%abund_C       = 2.2e-4
 par%abund_N       = 4.0e-5
 par%abund_O       = 3.3e-4
 par%abund_Ne      = 5.0e-5
 par%abund_S       = 9.0e-6

 par%source_geometry = 'point'
 par%file_format     = 'hdf5'
 par%out_file        = 'h2_3node.h5'
 par%amr_file       = '/nfs/mocafe/kiseon/MoCHII/MoCHII_v1.00/tests/g2_hii/hii20_L6.fits'
 par%launch_sequence = 'sobol'
 par%qmc_seed       = 20260728
 par%no_photons     = 1.0e5
 par%no_print       = 1.0e5
 par%gas_niter      = 3
 par%data_dir       = '/nfs/mocafe/kiseon/MoCHII/MoCHII_v1.00/data'
 par%atomic_dir     = '/nfs/mocafe/kiseon/MoCHII/MoCHII_v1.00/data/atomic'
 par%charge_exchange_heating = .false.   ! pinned: this input predates the default .true.
 par%hei_metastable_coupling = .false.   ! pinned: this input predates the default .true.
 par%twophoton_quenching = 'lumped_ne'   ! pinned: this input predates the default 'colliders'
 par%hei_on_the_spot = .false.   ! pinned: this input predates the default .true.
 par%heii_on_the_spot = .false.   ! pinned: this input predates the default .true.
/
