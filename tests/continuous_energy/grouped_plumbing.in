&parameters
 par%no_photons       = 1000
 par%no_print         = 1000
 par%iseed            = 1234

 par%grid_type        = 'car'
 par%car_walk         = 'amr'
 par%nx               = 4
 par%ny               = 4
 par%nz               = 4
 par%xmax             = 1.0
 par%ymax             = 1.0
 par%zmax             = 1.0
 par%nH_const         = 100.0
 par%rmax             = 1.0
 par%dust_model       = 'none'
 par%distance_unit    = 'pc'

 par%use_ion_band     = .true.
 par%ion_energy_mode  = 'grouped'
 par%source_cdf_tol   = 1.0e-8
 par%ion_shadow_rates = .true.
 par%nnu_ion          = 8
 par%eion_min         = 13.598
 par%eion_max         = 100.0
 par%tstar            = 4.0e4
 par%luminosity       = 3.177837e38

 par%xHI_init         = 1.0
 par%xHeI_init        = 1.0
 par%xHeII_init       = 0.0
 par%He_abund         = 0.1
 par%ion_add_dust     = .false.
 par%gas_niter        = 0
 par%te_fixed         = 1.0e4
 par%use_metals       = .true.
 par%source_geometry  = 'point'
 par%file_format      = 'hdf5'
 par%out_file         = 'grouped_plumbing.h5'
/
