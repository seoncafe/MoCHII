&parameters
 ! MoCHII He I 2^3S metastable gate -- HIGH density (collisional plateau direction).
 ! Uniform nH=1e4 sphere, R=0.6 pc, Q_H=1.06e50 (tstar 4e4 K, L = 3.18e39 erg/s), case B, Te=1e4 K
 ! fixed.  hei_metastable writes hei_highd_heimeta.h5 (n_2s3, Phi_3, n_e, T_e);
 ! the H/He ionization structure comes from the standard band solve.  In the
 ! ionized core n_e ~ n_H(1 + y_He) is above n_crit = 3502 cm^-3 (1e4 K), so
 ! n_3/n_HeII moves toward the collisional plateau
 ! alpha_3/(q_31g+q_31a+q_31b+q_31s+C_3).  No add_fuv: Phi_3 comes from the
 ! band above 13.6 eV only.

 par%no_photons    = 4.0e6
 par%no_print      = 4.0e6
 par%iseed         = 1234

 par%grid_type     = 'car'
 par%car_walk      = 'dda'
 par%nx            = 64
 par%ny            = 64
 par%nz            = 64
 par%xmax          = 0.6
 par%ymax          = 0.6
 par%zmax          = 0.6
 par%nH_const      = 1.0e4
 par%rmax          = 0.6
 par%dust_density_law = 'none'
 par%distance_unit = 'pc'

 par%nnu_ion       = 32
 par%eion_min      = 13.598
 par%eion_max      = 100.0
 par%tstar         = 4.0e4
 par%luminosity    = 3.177837e39

 par%xHI_init      = 1.0
 par%xHeI_init     = 1.0
 par%xHeII_init    = 0.0
 par%abund_He      = 0.1

 par%gas_niter     = 60
 par%conv_crit     = 'vol'
 par%conv_drift_test = .true.
 par%gas_tol       = 5.0e-3
 par%te_fixed      = 1.0e4
 par%solve_te      = .false.   ! pinned: this input predates solve_te = .true. as the default
 par%ion_relax     = 1.0
 par%recombination_continuum = 'on_the_spot'

 par%atomic_dir      = '../../data/atomic'
 par%hei_metastable  = .true.

 par%source_geometry = 'point'
 par%file_format     = 'hdf5'
 par%out_file        = 'hei_highd.h5'
 par%launch_sequence = 'random'   ! pinned: this input predates launch_sequence = 'sobol' as the default
 par%charge_exchange_heating = .false.   ! pinned: this input predates the default .true.
 par%hei_metastable_coupling = .false.   ! pinned: this input predates the default .true.
 par%twophoton_quenching = 'lumped_ne'   ! pinned: this input predates the default 'colliders'
 par%hei_on_the_spot = .false.   ! pinned: this input predates the default .true.
 par%heii_on_the_spot = .false.   ! pinned: this input predates the default .true.
 par%add_fuv = .false.   ! pinned: this input predates add_fuv following the 2^3S population
 par%jnu_output = .true.   ! pinned: the check reads J_nu, written only on request since 2026-09-26
/
