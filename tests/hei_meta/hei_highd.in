&parameters
 par%ion_energy_mode = 'grouped'
 ! MoCHII He I 2^3S metastable gate -- HIGH density (collisional plateau direction).
 ! Uniform nH=100 sphere, R=4 pc, Q_H=1e49 (tstar 4e4 K), case B, Te=1e4 K
 ! fixed.  hei_metastable writes hei_lowd_heimeta.h5 (n_2s3, Phi_3, n_e, T_e);
 ! the H/He ionization structure comes from the standard band solve.  In the
 ! ionized core n_e ~ n_H(1 + 2 y_He), n_HeII > 0, so n_e >> n_crit(~3900) so n_3/n_HeII moves toward the
 ! collisional plateau alpha_3/(q_31a+q_31b).  No add_fuv -> Phi_3 = 0.

 par%no_photons    = 4.0e6
 par%no_print      = 4.0e6
 par%iseed         = 1234

 par%grid_type     = 'car'
 par%car_walk      = 'dda'
 par%nx            = 64
 par%ny            = 64
 par%nz            = 64
 par%xmax          = 0.6
 par%ymax          = 0.6
 par%zmax          = 0.6
 par%nH_const      = 1.0e4
 par%rmax          = 0.6
 par%dust_model    = 'none'
 par%distance_unit = 'pc'

 par%nnu_ion       = 32
 par%eion_min      = 13.598
 par%eion_max      = 100.0
 par%tstar         = 4.0e4
 par%luminosity    = 3.177837e39

 par%xHI_init      = 1.0
 par%xHeI_init     = 1.0
 par%xHeII_init    = 0.0
 par%He_abund      = 0.1

 par%gas_niter     = 60
 par%conv_crit     = 'vol'
 par%gas_tol       = 5.0e-3
 par%te_fixed      = 1.0e4
 par%ion_relax     = 1.0
 par%case_ab       = 'B'

 par%atomic_dir      = '../../data/atomic'
 par%hei_metastable  = .true.

 par%source_geometry = 'point'
 par%file_format     = 'hdf5'
 par%out_file        = 'hei_highd.h5'
/
