&parameters
 ! tests/restart: the HII20 production input (results/continuous_energy/m4_nitrogen/hii20_nitrogen.in)
 ! with OUTNAME and NITER filled in by run_check.sh.
 par%charge_exchange = 'two_way'
 ! Continuous-energy production validation: Lexington HII20.
 ! Run from the repository root.  The Sobol packet count is a complete
 ! 2^25 net; nnu_ion controls diagnostics only in continuous mode.

 par%no_photons      = 33554432
 par%no_print        = 33554432
 par%iseed           = 1234
 par%launch_sequence = 'sobol'
 par%qmc_seed        = 20260728

 par%grid_type       = 'amr'
 par%amr_file        = '../../../tests/g2_hii/hii20_L6.fits'
 par%dust_density_law = 'none'
 par%distance_unit   = 'pc'

 par%source_cdf_tol  = 1.0e-8
 par%nnu_ion         = 32
 par%eion_min        = 13.598
 par%eion_max        = 100.0
 par%tstar           = 2.0e4
 par%luminosity      = 2.532600e38

 par%xHI_init        = 1.0e-3
 par%xHeI_init       = 0.5
 par%xHeII_init      = 0.5
 par%abund_He        = 0.1
 par%ion_add_dust    = .false.

 par%gas_niter       = NITER
 par%conv_crit       = 'vol'
 par%conv_drift_test = .true.
 par%gas_tol         = 5.0e-3
 par%gas_tol_te      = 1.0e-2
 par%ion_relax       = 1.0
 par%recombination_continuum = 'transported'
!--- Pinned rather than left to the default: a frozen production input must
!--- state the physics it was run with.  The residual experiments REPLACE
!--- this line, so it must be present exactly once.
 par%diffuse_energy_model = 'milne'
 par%hei_diffuse     = .true.
 par%solve_te        = .true.
 par%te_min          = 3.0e3
 par%te_max          = 3.0e4
 par%require_convergence = .true.

 par%atomic_dir      = '../../../data/atomic'
 par%data_dir        = '../../../data'
 par%use_metals      = .true.
 par%ion_metal_abs   = .true.
 par%metal_ne        = .true.
 par%metal_heat      = .true.
 par%abund_C         = 2.2e-4
 par%abund_N         = 4.0e-5
 par%abund_O         = 3.3e-4
 par%abund_Ne        = 5.0e-5
 par%abund_S         = 9.0e-6

 par%source_geometry = 'point'
 par%file_format     = 'hdf5'
 par%out_file        = 'OUTNAME.h5'
 par%charge_exchange_heating = .false.   ! pinned: this input predates the default .true.
 par%hei_metastable_coupling = .false.   ! pinned: this input predates the default .true.
 par%twophoton_quenching = 'lumped_ne'   ! pinned: this input predates the default 'colliders'
 par%hei_on_the_spot = .false.   ! pinned: this input predates the default .true.
 par%heii_diffuse = .false.   ! pinned: this input predates heii_diffuse following the transported continuum
 par%heii_on_the_spot = .false.   ! pinned: this input predates the default .true.
/
