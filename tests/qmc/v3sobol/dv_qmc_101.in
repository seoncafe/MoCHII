&parameters
 par%no_photons    = 5.0e5
 par%no_print      = 5.0e5
 par%iseed         = 1234
 par%grid_type     = 'car'
 par%car_walk      = 'dda'
 par%nx            = 32
 par%ny            = 32
 par%nz            = 32
 par%xmax          = 2.0
 par%ymax          = 2.0
 par%zmax          = 2.0
 par%nH_const      = 200.0
 par%rmax          = 1.9
 par%dust_density_law = 'none'
 par%distance_unit = 'pc'
 par%nnu_ion       = 16
 par%eion_min      = 13.598
 par%eion_max      = 100.0
 par%tstar         = 4.0e4
 par%luminosity    = 1.5e37
 par%xHI_init      = 1.0
 par%xHeI_init     = 1.0
 par%xHeII_init    = 0.0
 par%abund_He      = 0.1
 par%ion_add_dust  = .false.
 par%gas_niter     = 40
 par%gas_tol       = 5.0e-3
 par%te_fixed      = 1.0e4
 par%solve_te      = .false.   ! pinned: this input predates solve_te = .true. as the default
 par%ion_relax     = 1.0
 par%recombination_continuum = 'transported'
 par%conv_crit     = 'vol'
 par%conv_drift_test = .true.
 par%source_geometry = 'point'
 par%launch_sequence = 'sobol'
 par%qmc_seed        = 101
 par%file_format     = 'hdf5'
 par%out_file        = 'dv_qmc_101.h5'
 par%charge_exchange_heating = .false.   ! pinned: this input predates the default .true.
 par%hei_metastable_coupling = .false.   ! pinned: this input predates the default .true.
 par%twophoton_quenching = 'lumped_ne'   ! pinned: this input predates the default 'colliders'
 par%hei_on_the_spot = .false.   ! pinned: this input predates the default .true.
 par%hei_diffuse = .false.   ! pinned: this input predates hei_diffuse following the transported continuum
 par%heii_diffuse = .false.   ! pinned: this input predates heii_diffuse following the transported continuum
 par%heii_on_the_spot = .false.   ! pinned: this input predates the default .true.
/
