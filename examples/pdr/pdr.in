&parameters
 ! Photodissociation region (PDR): the neutral gas just beyond the
 ! ionization front.  The FUV band (added under the ionizing band) drives
 ! grain photoelectric heating, while metal electrons and metal-line cooling
 ! ([C II] 158um, [O I] 63um, and the fine-structure lines) set the
 ! temperature there.  The grid is a refined octree sphere read from a file.
 ! Note: this run is slower than the gas-only examples because the metal
 ! electron fixed point is solved inside the temperature bisection.
 par%no_photons    = 2.0e6
 par%iseed         = 1234

 par%grid_type     = 'amr'
 par%amr_file      = 'amr_sphere_L5_nH100.fits.gz'
 par%dust_density_law = 'global_dgr'

 par%nnu_ion       = 32
 par%add_fuv       = .true.         ! FUV band under the ionizing band
 par%efuv_min      = 6.0            ! lower FUV edge [eV]
 !   6 eV: grain_pe takes G0 = 4 pi J / 1.6e-3 erg s^-1 cm^-2 summed over the
 !   whole FUV band, and the Habing G0 of the BT94 fits is 6-13.6 eV; Phi_3
 !   then misses 4.78-6 eV (setup NOTE)
 par%nnu_fuv       = 16
 par%tstar         = 4.0e4          ! blackbody source [K]
 par%luminosity    = 3.178e38       ! ionizing-band luminosity [erg/s]
 par%abund_He      = 0.1
 par%xHI_init      = 1.0e-3
 par%xHeI_init     = 0.0
 par%xHeII_init    = 1.0

 par%gas_niter     = 15
 par%conv_crit     = 'vol'
 par%gas_tol       = 5.0e-3
 par%gas_tol_te    = 1.0e-2
 par%recombination_continuum = 'transported'

 par%solve_te      = .true.
 par%te_min        = 100.0          ! low floor for the neutral gas [K]
 par%te_max        = 3.0e4
 par%use_metals    = .true.
 par%atomic_dir    = '../../data/atomic'
 par%abund_C       = 2.2e-4
 par%abund_O       = 3.3e-4
 par%abund_Mg      = 3.0e-6
 par%abund_Fe      = 3.0e-7
 par%ion_metal_abs = .true.         ! metal photoionization opacity in the band

 par%ion_add_dust    = .true.
 par%dust_emis_transport = .true.    ! transport the reradiated IR back onto the grains
 par%ion_dust_scatter = .true.
 par%ion_dust_kext   = '../../data/kext_albedo_WD_MW_3.1_60_D03.all_2003'
 par%cext_dust       = 4.868e-22
 par%DGR             = 1.0

 par%metal_ne      = .true.         ! metal electrons in the ionization balance
 par%metal_heat    = .true.         ! metal photoheating in the thermal balance
 par%grain_pe      = .true.         ! grain photoelectric heating (BT94)

 par%source_geometry = 'point'
 par%file_format     = 'hdf5'
 par%out_file        = 'pdr.h5'
 par%launch_sequence = 'sobol'   ! better with no_photons = 2^m, e.g. 2^21 = 2097152 (a Sobol set of 2^m points fills most evenly)
 par%abund_N  = 4.0e-5   ! pinned: this input predates zero default abundances
 par%abund_Ne = 5.0e-5   ! pinned: this input predates zero default abundances
 par%abund_S  = 9.0e-6   ! pinned: this input predates zero default abundances
 par%charge_exchange_heating = .true.
 par%hei_metastable_coupling = .true.
 par%twophoton_quenching = 'colliders'
 par%hei_diffuse = .true.
 par%heii_diffuse = .true.
/
