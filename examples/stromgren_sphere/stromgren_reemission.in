&parameters
 ! The Stromgren sphere of stromgren_sphere.in with the diffuse field
 ! re-emitted at the absorption point (par%diffuse_launch =
 ! 'absorption_reemission'): an ionizing packet absorbed by H0, He0 or He+
 ! continues from that point as a recombination packet of the ion it
 ! produced, its weight scaled by the in-band energy one recombination
 ! radiates over the absorbed photon's energy; what that does not carry is
 ! launched from the cells as in the default.  Needs
 ! par%recombination_continuum = 'transported'.  The first iteration has no
 ! previous field and is the default scheme.  Compare its _rates.h5 with
 ! stromgren_sphere_rates.h5.  The extra
 ! outputs (L_REEMIT, ReemittedLuminosity, ReemissionPsi, ...) are listed in
 ! the User Guide.
 par%no_photons    = 1.0e6
 par%iseed         = 1234

 par%grid_type     = 'car'
 par%nx = 48
 par%ny = 48
 par%nz = 48
 par%xmax = 4.0
 par%ymax = 4.0
 par%zmax = 4.0
 par%nH_const      = 100.0          ! cm^-3 inside the sphere
 par%rmax          = 3.8            ! sphere radius (pc); nH = 0 outside
 par%distance_unit = 'pc'
 par%dust_density_law = 'none'

 par%nnu_ion       = 32
 par%tstar         = 4.0e4          ! blackbody source [K]
 par%luminosity    = 3.177837e38    ! ionizing-band luminosity [erg/s]
 par%abund_He      = 0.1
 par%xHI_init      = 1.0e-3

 par%gas_niter     = 40
 par%conv_crit     = 'vol'
 par%gas_tol       = 5.0e-3
 par%recombination_continuum = 'transported'
 par%te_fixed      = 1.0e4          ! fixed electron temperature [K]
 par%solve_te      = .false.   ! Te held at te_fixed (solve_te defaults to .true.)

 par%source_geometry = 'point'
 par%out_file        = 'stromgren_reemission.h5'
 par%launch_sequence = 'sobol'   ! better with no_photons = 2^m, e.g. 2^20 = 1048576 (a Sobol set of 2^m points fills most evenly)
 par%charge_exchange_heating = .true.
 par%hei_metastable_coupling = .true.
 par%twophoton_quenching = 'colliders'
 par%hei_diffuse = .true.
 par%heii_diffuse = .true.
 par%diffuse_launch = 'absorption_reemission'
/
