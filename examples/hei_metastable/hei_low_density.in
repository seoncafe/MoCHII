&parameters
 ! He I 2^3S metastable diagnostic, LOW-density (radiative) limit.
 !
 ! A Stromgren sphere (uniform nH=100, R=4 pc, hot star, transported
 ! recombination continuum, fixed Te=1e4 K) with par%hei_metastable = .true.,
 ! which writes
 ! hei_low_density_heimeta.h5 with the 2^3S number density n_2s3, the 2^3S
 ! photoionization rate Phi_3, n_e, and T_e.  The 2^3S population (a ~1e-7
 ! trace of helium) also feeds back into the ionization balance and the He I
 ! recombination photons through par%hei_metastable_coupling (explicitly enabled below).
 !
 ! What this run shows: in the ionized core n_e ~ 110 cm^-3, far below the
 ! critical density n_crit = A_31/(q_31g+q_31a+q_31b+q_31s+C_3) = 3502 cm^-3
 ! at 1e4 K, so the metastable balance sits in the low-density RADIATIVE
 ! limit -- the electron-impact sink is ~3% of A_31 and
 !    n_3/n_HeII  ->  alpha_3 n_e / A_31   (1.68e-7 at n_e=100, 1e4 K).
 ! This input keeps the band at the H edge (par%add_fuv = .false. below; the
 ! default would extend it to 4.78 eV because the 2^3S population is used),
 ! so Phi_3 keeps only the EUV part (>= 13.6 eV), which is << A_31 in the
 ! core, and the radiative limit holds (compare hei_low_density_fuv, which
 ! adds the soft-UV part and depletes n_3 near the star).
 par%no_photons    = 2.0e6
 par%iseed         = 1234

 par%grid_type     = 'car'
 par%nx = 48
 par%ny = 48
 par%nz = 48
 par%xmax = 4.0
 par%ymax = 4.0
 par%zmax = 4.0
 par%nH_const      = 100.0          ! cm^-3 inside the sphere
 par%rmax          = 3.8            ! sphere radius (pc); nH = 0 outside
 par%distance_unit = 'pc'
 par%dust_density_law = 'none'

 par%nnu_ion       = 32
 par%add_fuv       = .false.        ! no band below 13.6 eV: the EUV-only Phi_3
 par%tstar         = 4.0e4          ! blackbody source [K]
 par%luminosity    = 3.177837e38    ! ionizing-band luminosity [erg/s]
 par%abund_He      = 0.1
 par%xHI_init      = 1.0e-3

 par%gas_niter     = 40
 par%conv_crit     = 'vol'
 par%gas_tol       = 5.0e-3
 par%recombination_continuum = 'transported'
 par%te_fixed      = 1.0e4          ! fixed electron temperature [K]
 par%solve_te      = .false.   ! Te held at te_fixed (solve_te defaults to .true.)

 par%atomic_dir      = '../../data/atomic'   ! for hei_metastable.txt
 par%hei_metastable  = .true.                ! write the 2^3S population

 par%source_geometry = 'point'
 par%out_file        = 'hei_low_density.h5'
 par%launch_sequence = 'sobol'   ! better with no_photons = 2^m, e.g. 2^21 = 2097152 (a Sobol set of 2^m points fills most evenly)
 par%charge_exchange_heating = .true.
 par%hei_metastable_coupling = .true.
 par%twophoton_quenching = 'colliders'
 par%hei_diffuse = .true.
 par%heii_diffuse = .true.
/
