&parameters
 par%ion_energy_mode = 'grouped'
 ! He I 2^3S metastable diagnostic, LOW-density + soft-UV photoionization.
 !
 ! Identical to hei_low_density, plus a soft-UV FUV band reaching down to the
 ! 2^3S ionization threshold at 4.78 eV (par%add_fuv, efuv_min=4.78).  The
 ! extra low-energy photons raise the 2^3S photoionization rate Phi_3, adding
 ! a sink to the metastable balance and depleting n_3 where the field is
 ! strong (near the star).  par%hei_metastable = .true. adds only the
 ! diagnostic pass; the switch changes no physics.
 !
 ! What this run shows: with the soft-UV band, Phi_3 climbs to a substantial
 ! fraction of A_31 near the source (the gate reaches Phi_3 ~ 9e-5 s^-1 vs
 ! A_31 = 1.272e-4), so n_3 is pushed below the pure radiative value of
 ! hei_low_density -- the plot script contrasts n_3^fuv/n_3^noFUV against the
 ! Phi_3/A_31 profile.  Without add_fuv (hei_low_density) only the EUV band
 ! (>= 13.6 eV) photoionizes 2^3S, and Phi_3 stays << A_31 in the core; the
 ! soft-UV segment [4.78, 13.6) eV is what makes Phi_3 matter.  This is the
 ! regime relevant to exoplanet-transit and chromospheric 10833 absorption,
 ! where the soft-UV field controls the metastable reservoir.
 par%no_photons    = 2.0e6
 par%iseed         = 1234

 par%grid_type     = 'car'
 par%nx = 48
 par%ny = 48
 par%nz = 48
 par%xmax = 4.0
 par%ymax = 4.0
 par%zmax = 4.0
 par%nH_const      = 100.0          ! cm^-3 inside the sphere
 par%rmax          = 3.8            ! sphere radius (pc); nH = 0 outside
 par%distance_unit = 'pc'
 par%dust_model    = 'none'

 par%nnu_ion       = 32
 par%add_fuv       = .true.         ! add a soft-UV band below 13.6 eV
 par%efuv_min      = 4.78           ! down to the 2^3S threshold [eV]
 par%nnu_fuv       = 16
 par%tstar         = 4.0e4          ! blackbody source [K]
 par%luminosity    = 3.177837e38    ! ionizing-band luminosity [erg/s]
 par%He_abund      = 0.1
 par%xHI_init      = 1.0e-3

 par%gas_niter     = 40
 par%conv_crit     = 'vol'
 par%gas_tol       = 5.0e-3
 par%case_ab       = 'B'
 par%te_fixed      = 1.0e4          ! fixed electron temperature [K]

 par%atomic_dir      = '../../data/atomic'   ! for hei_metastable.txt
 par%hei_metastable  = .true.                ! 2^3S diagnostic (no physics change)

 par%source_geometry = 'point'
 par%out_file        = 'hei_low_density_fuv.h5'
/
