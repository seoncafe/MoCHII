backup/

# Compiled objects and modules
*.o
*.mod
*.smod

# Executables
*.x

# FITS/HDF5 output files
*.fits
*.fits.gz
*.h5
*.hdf5
*.log
log
output*/

# examples: track the INPUT grids / density cubes used by the example
# namelists (the run OUTPUTS under examples/ -- *_rates.h5, *_emis.h5,
# *_image.h5, *_dustsed.h5, *_lines.txt, run.log -- stay ignored).
!examples/**/*.fits
!examples/**/*.fits.gz
!examples/**/*.hdf5

# run output text products
*_lines.txt
*_nebcont.txt
*_dustir.txt
*_dustsed.txt

# etc
*.png
!docs/mochii_icon.png
.vscode/

# Editor backups / swap
*~
*.swp
*.bak

# macOS
.DS_Store

# gitignore
.gitignore
git-update.sh

# LaTeX files
*.cls
*.dvi
*.aux
*.toc
*.out
*.synctex.gz
*.fls
*.fdb_latexmk
docs/figures/
!my_memo.cls

# Jupyter / python
.ipynb_checkpoints/
*.ipynb
*.pyc
__pycache__/

#CLAUDE
.claude

# SEDust build artifacts (rebuilt by SEDust/sed/build_lib.sh)
SEDust/sed/lib/
# SEDust D16 spheroid Q-lib (17 MB), read only by q_graphite_d16_mod which
# nothing uses by default -- kept out of git; run SEDust/populate_data.sh to fetch.
SEDust/data/dielectric/qlib_gra_D16MGemt_1.400

# slab boundary I(mu) checker outputs (regenerable by tests/slab/check_slab.py)
tests/slab/*_slab_Imu.txt
docs/Draine2026_HeI10833_tau.*

